<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>reaper_hulp</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Required: tells the AOT linker to produce a true native shared library (DLL)
             with a proper export table. Without this, [UnmanagedCallersOnly] exports
             will NOT appear in the PE export table and LoadLibrary/GetProcAddress won't work. -->
        <NativeLib>Shared</NativeLib>
        <RootNamespace>Hemisphera.Hulp.Plugin</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Hsp.Osc" Version="0.0.27" />
        <PackageReference Include="Hsp.ReaSharp" Version="0.0.3"/>
        <ProjectReference Include="..\..\ReaSharp\ReaSharp\ReaSharp.csproj"/>
        <ProjectReference Include="..\Hemisphera.Hulp.Types\Hemisphera.Hulp.Types.csproj" />
    </ItemGroup>

</Project>
