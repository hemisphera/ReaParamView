@inject OscService OscService
@using System.Globalization
@implements IDisposable

<div class="ev-wrapper">
    <div class="fx-section-label">Upcoming</div>
    @{
        var events = OscService.GetUpcomingEvents();
    }
    @if (events.Count == 0)
    {
        <div class="ev-empty">No upcoming events</div>
    }
    else
    {
        var currPos = OscService.Transport.Position;
        @for (var i = 0; i < events.Count; i++)
        {
            var isNext = i == 0;
            var ev = events[i];
            var gaugeWidth = 0;
            var displayValue = "";
            if (isNext)
            {
                var remaining = Math.Round(ev.Position - currPos, 2);
                displayValue = remaining > 16 ? "+++" : remaining.ToString(CultureInfo.InvariantCulture);
                gaugeWidth = (int)(remaining > 16 ? 100 : Math.Max(0, remaining / 16.0 * 100));
            }

            <div class="ev-item @(isNext ? "ev-item--next" : "")">
                <div class="ev-item-gauge" style="width: @(gaugeWidth)%"></div>
                <div class="ev-item-text">@ev.Text</div>
                @if (isNext)
                {
                    <div class="ev-item-meta">
                        <span class="ev-item-time">@displayValue</span>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private System.Timers.Timer _timer = null!;

    protected override void OnInitialized()
    {
        OscService.UpcomingEventsChanged += Refresh;
        OscService.TransportChanged += Refresh;
        _timer = new System.Timers.Timer(1000) { AutoReset = true };
        _timer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        _timer.Start();
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }


    public void Dispose()
    {
        OscService.UpcomingEventsChanged -= Refresh;
        OscService.TransportChanged -= Refresh;
        _timer.Dispose();
    }

}
